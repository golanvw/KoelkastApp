<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KoelkastApp.KoelkastSettingsPage"
             xmlns:local="clr-namespace:KoelkastApp.MVVM.ViewModels">
    <ContentPage.BindingContext>
        <local:KoelkastPageViewModel/>
    </ContentPage.BindingContext>
    <ContentPage.Content>
        <StackLayout>
            <Label
                Text="Koelkast naam"/>
            <Entry
                Placeholder="Koelkast naam"
                Text="{Binding CurrentKoelkast.KoelkastName}"/>
            <Button
                x:Name="SaveSettingsBtn"
                Text="instellingen opslaan"
                Clicked="SaveSettingsBtn_Clicked"/>
            <Button
                Text="Delete"
                BackgroundColor="Red"
                Command="{Binding Deletecommand}"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>